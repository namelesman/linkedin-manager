# Copie para .env e preencha. Nunca commite o .env.

# Neon Postgres (Vercel Marketplace ou console.neon.tech)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Auth.js: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# App do LinkedIn (developer.linkedin.com > Auth)
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Único e-mail autorizado a entrar no painel
ALLOWED_EMAIL=""

# Chave de 32 bytes em base64 para criptografar o token do LinkedIn: `openssl rand -base64 32`
TOKEN_ENC_KEY=""

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Versão da API REST do LinkedIn no formato YYYYMM
LINKEDIN_VERSION="202610"

# Segredo compartilhado com o GitHub Actions para chamar /api/cron/publish
CRON_SECRET=""

# URL pública do app (sem barra no final)
APP_URL="http://localhost:3000"
